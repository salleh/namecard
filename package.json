{
  "name": "e-namecard",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Sallehuddin Abdul Latif <sallehuddin@gmail.com>",
  "engines": {
    "node": ">=24.18.1"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "dotenv -e .env.dev -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "db:migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "db:migrate:status": "dotenv -e .env.dev -- prisma migrate status",
    "db:seed": "dotenv -e .env.dev -- prisma db seed",
    "db:studio": "dotenv -e .env.dev -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "qr-code-styling": "1.9.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.0",
    "@serwist/next": "9.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv-cli": "11.0.0",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "25.0.1",
    "postcss": "^8.5.25",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "serwist": "9.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
