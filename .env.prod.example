# Production environment. On the docker host this file lives at
# /home/encard/data/.env.prod (NEVER in the repo clone). Copy from this sample.
# Consumed by the db, migrator, and app services (caddy needs no env).

# ---- Postgres container ----
POSTGRES_USER=encard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_SECRET
POSTGRES_DB=namecard

# ---- App (runs in-cluster; connects to the db service by name) ----
DATABASE_URL=postgresql://encard:CHANGE_ME_STRONG_SECRET@db:5432/namecard

# ---- Auth.js (prod) — from the PROD Entra app registration ----
# Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
# Public HTTPS origin (TLS terminates at the DMZ nginx).
AUTH_URL=https://namecard.example.com
AUTH_MICROSOFT_ENTRA_APPLICATION_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ---- Admin gate ----
ADMIN_GROUP_ID=
