# Integration test environment. Copy to .env.test (git-ignored).
# Points at a SEPARATE database in the same dev Postgres container so
# integration tests never touch the `namecard` dev database.
#
# One-time setup (dev Postgres already running via `npm run db:up`):
#   docker compose exec -T db psql -U encard -d namecard \
#     -c "CREATE DATABASE namecard_test"
#
# Then apply migrations to it: npm run test:integration (does this automatically).

DATABASE_URL=postgresql://encard:devpassword@localhost:5432/namecard_test
