# ---- Runtime ----
NODE_ENV=development

# ---- Database (Step 2) ----
# Prisma/PostgreSQL connection string.
DATABASE_URL=postgresql://encard:changeme@localhost:5432/namecard

# ---- Auth.js session (Step 5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public origin used for OIDC redirects/cookies. Prod: https://namecard.example.com (your FQDN)
AUTH_URL=http://localhost:3000

# ---- Entra ID app registration (Step 5) ----
# Tenant-specific issuer — NEVER "common".
AUTH_MICROSOFT_ENTRA_APPLICATION_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ---- Admin gate (Step 5/7) ----
# Object ID of the M365 security group whose members may access the admin console.
ADMIN_GROUP_ID=
